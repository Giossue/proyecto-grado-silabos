AI_DRIVER=
AI_BASE_URL=
AI_MODEL=
AI_TEMPLATE_MODEL=
AI_API_KEY=
AI_CONNECT_TIMEOUT=10
AI_TIMEOUT=120

CATALOG_DRIVER=
KOHA_BASE_URL=

SIGNATURE_TRUSTED_CA_BUNDLE=
