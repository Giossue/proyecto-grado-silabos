APP_LOCALE=es
FRONTEND_URL=http://localhost:3000
API_PORT=8000
API_INTERNAL_URL=http://localhost:8000
DISPLAY_TIMEZONE=America/Guayaquil

DATABASE_URL=postgres://silabos:change-me@localhost:5432/silabos_ueb
SHADOW_DATABASE_URL=
REDIS_URL=redis://localhost:6379/0
REDIS_PREFIX=silabos-ueb:
GOTENBERG_URL=http://localhost:3001

SESSION_LIFETIME=240
SESSION_COOKIE_PREFIX=silabos-ueb
STATEFUL_DOMAINS=localhost:3000
TRUSTED_PROXIES=

STORAGE_DRIVER=local
STORAGE_PATH=/path/to/shared/storage
PUBLIC_ASSETS_PATH=
S3_ENDPOINT=http://localhost:9000
