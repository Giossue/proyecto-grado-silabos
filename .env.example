APP_NAME="Sílabos UEB"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_TIMEZONE=UTC
DISPLAY_TIMEZONE=America/Guayaquil
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=55432
DB_DATABASE=silabos_ueb
DB_USERNAME=silabos_ueb
DB_PASSWORD=silabos_ueb
DB_TIMEZONE=UTC

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=private
QUEUE_CONNECTION=redis
REDIS_QUEUE_RETRY_AFTER=180

CACHE_STORE=redis
CACHE_PREFIX=silabos-ueb

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=56379

AI_DRIVER=disabled
AI_LOCAL_URL=http://127.0.0.1:8081/v1/analyze
AI_LOCAL_VERSION=local-http-v1
AI_CONNECT_TIMEOUT=2
AI_TIMEOUT=20

# `log` no envía: escribe el correo en el registro. Es el valor seguro mientras PV-15
# —correo institucional y contenido de avisos— siga abierta.
# Para enviar de verdad: MAIL_MAILER=resend y RESEND_API_KEY con la clave del panel.
MAIL_MAILER=log
RESEND_API_KEY=
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-responder@devs-ueb.tech"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
