S3_BUCKET=silabos
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me-at-least-8-characters
S3_FORCE_PATH_STYLE=true
MINIO_IMAGE=
MINIO_MC_IMAGE=
MINIO_CONSOLE_PORT=9001
POST_MAX_SIZE=32M
BCRYPT_ROUNDS=12

QUEUE_MAX_TIME=0
QUEUE_RETRY_AFTER=90

MAIL_MAILER=log
MAIL_SCHEME=
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@example.com
