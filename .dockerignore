.github
.env
.env.*
node_modules
public/build
# `public/hot` lo escribe el servidor de desarrollo. Si viaja a la imagen, `@vite` sirve
# URLs de localhost:5173 y la aplicación desplegada se queda sin assets.
public/hot
public/storage
public/fonts-manifest.dev.json
storage/logs/*.log
storage/inertia-devtools
storage/framework/cache/data
storage/framework/sessions
storage/framework/views
# El descubrimiento de paquetes cacheado en local incluye proveedores de desarrollo, que
# no existen en la imagen. Se regenera dentro del contenedor.
bootstrap/cache/*.php
vendor
tests
docs
*.md
!README.md
.phpunit.cache
.phpunit.result.cache
phpstan.neon
pint.json
phpunit.xml
eslint.config.js
compose.yaml
