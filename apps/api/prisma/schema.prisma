generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["views", "partialIndexes"]
  moduleFormat    = "cjs"
  runtime         = "nodejs"
}

datasource db {
  provider = "postgresql"
}

model ajustes_sistema {
  clave_ajuste   String    @id @db.VarChar(60)
  valor_ajuste   Json
  modificado_por String?   @db.Uuid
  modificado_en  DateTime  @default(now()) @db.Timestamptz(0)
  usuarios       usuarios? @relation(fields: [modificado_por], references: [usuario_id], onUpdate: NoAction, map: "ajustes_sistema_modificado_por_foreign")

  @@index([modificado_por], map: "ajustes_sistema_modificado_por_index")
}

model aprobaciones {
  aprobacion_id          String            @id @db.Uuid
  revision_silabo_id     String            @unique(map: "aprobaciones_revision_silabo_id_unique") @db.Uuid
  clave_solicitud        String            @db.Uuid
  hash_contenido         String            @db.Char(64)
  aprobado_por           String            @db.Uuid
  aprobado_en            DateTime          @db.Timestamptz(0)
  aprobacion_anterior_id String?           @db.Uuid
  aprobaciones           aprobaciones?     @relation("aprobacionesToaprobaciones", fields: [aprobacion_anterior_id], references: [aprobacion_id], onDelete: Restrict, onUpdate: NoAction, map: "aprobaciones_aprobacion_anterior_id_foreign")
  other_aprobaciones     aprobaciones[]    @relation("aprobacionesToaprobaciones")
  usuarios               usuarios          @relation(fields: [aprobado_por], references: [usuario_id], onUpdate: NoAction, map: "aprobaciones_aprobado_por_foreign")
  revisiones_silabo      revisiones_silabo @relation(fields: [revision_silabo_id], references: [revision_silabo_id], onUpdate: NoAction, map: "aprobaciones_revision_silabo_id_foreign")

  @@index([aprobacion_anterior_id], map: "aprobaciones_aprobacion_anterior_id_index")
  @@index([aprobado_por], map: "aprobaciones_aprobado_por_index")
}

model archivos {
  archivo_id                                                   String                @id @db.Uuid
  disco                                                        String                @db.VarChar(80)
  ruta_archivo                                                 String                @db.VarChar(500)
  nombre_archivo                                               String                @db.VarChar(255)
  tipo_archivo                                                 String                @db.VarChar(120)
  tamano_bytes                                                 BigInt
  hash_archivo                                                 String                @db.Char(64)
  categoria                                                    String                @db.VarChar(80)
  subido_por                                                   String?               @db.Uuid
  almacenado_en                                                DateTime              @db.Timestamptz(0)
  usuarios                                                     usuarios?             @relation(fields: [subido_por], references: [usuario_id], onDelete: Restrict, onUpdate: NoAction, map: "archivos_subido_por_foreign")
  documentos_apoyo_documentos_apoyo_archivo_idToarchivos       documentos_apoyo?     @relation("documentos_apoyo_archivo_idToarchivos")
  documentos_apoyo_documentos_apoyo_archivo_vista_idToarchivos documentos_apoyo[]    @relation("documentos_apoyo_archivo_vista_idToarchivos")
  exportaciones_silabo                                         exportaciones_silabo?
  facultades                                                   facultades[]

  @@unique([disco, ruta_archivo], map: "archivos_disco_ruta_archivo_unique")
  @@index([categoria, almacenado_en], map: "archivos_categoria_almacenado_en_index")
  @@index([hash_archivo], map: "archivos_hash_archivo_index")
  @@index([subido_por], map: "archivos_subido_por_index")
}

model asignaciones_paralelo {
  asignacion_paralelo_id     String           @id @db.Uuid
  paralelo_id                String           @unique(map: "asignaciones_paralelo_paralelo_activo_unico", where: raw("asignacion_paralelo_activa")) @db.Uuid
  asignacion_paralelo_activa Boolean          @default(true)
  asignado_en                DateTime         @default(now()) @db.Timestamptz(0)
  asignacion_rol_id          String           @db.Uuid
  asignaciones_rol           asignaciones_rol @relation(fields: [asignacion_rol_id], references: [asignacion_rol_id], onUpdate: NoAction, map: "asignaciones_paralelo_asignacion_rol_id_foreign")
  paralelos                  paralelos        @relation(fields: [paralelo_id], references: [paralelo_id], onUpdate: NoAction, map: "asignaciones_paralelo_paralelo_id_foreign")

  @@index([asignacion_rol_id, asignacion_paralelo_activa], map: "asignaciones_paralelo_activa_idx")
}

