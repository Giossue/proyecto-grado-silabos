  @@unique([asignatura_id, definicion_campo_id], map: "valores_campo_asignatura_definicion_unica", where: raw("(asignatura_id IS NOT NULL)"))
  @@unique([silabo_id, definicion_campo_id], map: "valores_campo_silabo_definicion_unica", where: raw("(silabo_id IS NOT NULL)"))
  @@index([definicion_campo_id])
}

model verificaciones_usuario {
  id         String   @id
  identifier String
  value      String
  expires_at DateTime @db.Timestamptz(6)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([identifier])
}

view docentes_vigentes_silabo {
  silabo_id              String @db.Uuid
  usuario_id             String @db.Uuid
  asignacion_rol_id      String @db.Uuid
  asignacion_paralelo_id String @db.Uuid
  paralelo_id            String @db.Uuid

  @@unique([silabo_id, asignacion_paralelo_id])
}
