exports[`CoordinatorSummaryMail > lists only careers with syllabi to review and links to the reviews 1`] = `"<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd"><html dir="ltr" lang="es"><head><meta content="text/html; charset=UTF-8" http-equiv="Content-Type"/><meta name="x-apple-disable-message-reformatting"/><title>Sílabos UEB</title></head><body style="background-color:#eef2f7;margin:0;padding:0"><!--$--><!--html--><!--head--><!--body--><table border="0" width="100%" cellPadding="0" cellSpacing="0" role="presentation" align="center"><tbody><tr><td style="background-color:#eef2f7;color:#121c28;font-family:-apple-system, BlinkMacSystemFont, &#x27;Segoe UI&#x27;, Roboto, Helvetica, Arial, sans-serif, &#x27;Apple Color Emoji&#x27;, &#x27;Segoe UI Emoji&#x27;, &#x27;Segoe UI Symbol&#x27;;margin:0;padding:0;width:100%"><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="padding:25px 0;text-align:center"><tbody><tr><td><a href="http://localhost:3000" style="color:#122c41;text-decoration-line:none;font-size:19px;font-weight:bold;text-decoration:none" target="_blank">Sílabos UEB</a></td></tr></tbody></table><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="max-width:570px;background-color:#ffffff;border:1px solid #dbe3ec;border-radius:2px;margin:0 auto 32px;padding:32px"><tbody><tr style="width:100%"><td><h1 style="color:#122c41;font-size:18px;font-weight:bold;margin:0 0 16px;text-align:left">Pendientes de hoy</h1><p style="font-size:16px;line-height:1.5em;margin:0 0 16px;text-align:left;margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0">Hola Carlos Ruiz:</p><ul style="font-size:16px;line-height:1.5em;margin:0 0 16px;text-align:left;padding-left:20px"><li>Ingeniería en Software: 1 sílabo por revisar.</li><li>Medicina &amp; &lt;Salud&gt;: 3 sílabos por revisar.</li></ul><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="margin:30px auto;text-align:center"><tbody><tr><td><a href="http://localhost:3000/coordinacion/revisiones" style="line-height:100%;text-decoration:none;display:inline-block;max-width:100%;mso-padding-alt:0px;background-color:#122c41;border-radius:4px;color:#ffffff;padding:8px 18px;padding-top:8px;padding-right:18px;padding-bottom:8px;padding-left:18px" target="_blank"><span><!--[if mso]><i style="mso-font-width:450%;mso-text-raise:12" hidden>&#8202;&#8202;</i><![endif]--></span><span style="max-width:100%;display:inline-block;line-height:120%;mso-padding-alt:0px;mso-text-raise:6px">Abrir revisión</span><span><!--[if mso]><i style="mso-font-width:450%" hidden>&#8202;&#8202;&#8203;</i><![endif]--></span></a></td></tr></tbody></table></td></tr></tbody></table></td></tr></tbody></table><!--/$--></body></html>"`;

exports[`DailySummaryMail > lists the pending work of the day 1`] = `"<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd"><html dir="ltr" lang="es"><head><meta content="text/html; charset=UTF-8" http-equiv="Content-Type"/><meta name="x-apple-disable-message-reformatting"/><title>Sílabos UEB</title></head><body style="background-color:#eef2f7;margin:0;padding:0"><!--$--><!--html--><!--head--><!--body--><table border="0" width="100%" cellPadding="0" cellSpacing="0" role="presentation" align="center"><tbody><tr><td style="background-color:#eef2f7;color:#121c28;font-family:-apple-system, BlinkMacSystemFont, &#x27;Segoe UI&#x27;, Roboto, Helvetica, Arial, sans-serif, &#x27;Apple Color Emoji&#x27;, &#x27;Segoe UI Emoji&#x27;, &#x27;Segoe UI Symbol&#x27;;margin:0;padding:0;width:100%"><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="padding:25px 0;text-align:center"><tbody><tr><td><a href="http://localhost:3000" style="color:#122c41;text-decoration-line:none;font-size:19px;font-weight:bold;text-decoration:none" target="_blank">Sílabos UEB</a></td></tr></tbody></table><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="max-width:570px;background-color:#ffffff;border:1px solid #dbe3ec;border-radius:2px;margin:0 auto 32px;padding:32px"><tbody><tr style="width:100%"><td><h1 style="color:#122c41;font-size:18px;font-weight:bold;margin:0 0 16px;text-align:left">Pendientes de hoy</h1><p style="font-size:16px;line-height:1.5em;margin:0 0 16px;text-align:left;margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0">Hola María Pérez:</p><ul style="font-size:16px;line-height:1.5em;margin:0 0 16px;text-align:left;padding-left:20px"><li>Ingeniería en Software: 2 sílabos en borrador.</li><li>Derecho: 1 sílabo por corregir.</li></ul><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="margin:30px auto;text-align:center"><tbody><tr><td><a href="http://localhost:3000/docente/mis-silabos" style="line-height:100%;text-decoration:none;display:inline-block;max-width:100%;mso-padding-alt:0px;background-color:#122c41;border-radius:4px;color:#ffffff;padding:8px 18px;padding-top:8px;padding-right:18px;padding-bottom:8px;padding-left:18px" target="_blank"><span><!--[if mso]><i style="mso-font-width:450%;mso-text-raise:12" hidden>&#8202;&#8202;</i><![endif]--></span><span style="max-width:100%;display:inline-block;line-height:120%;mso-padding-alt:0px;mso-text-raise:6px">Abrir mis sílabos</span><span><!--[if mso]><i style="mso-font-width:450%" hidden>&#8202;&#8202;&#8203;</i><![endif]--></span></a></td></tr></tbody></table></td></tr></tbody></table></td></tr></tbody></table><!--/$--></body></html>"`;

exports[`ManagedUserActivationMail > invites a career user with high priority and the activation link 1`] = `"<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd"><html dir="ltr" lang="es"><head><meta content="text/html; charset=UTF-8" http-equiv="Content-Type"/><meta name="x-apple-disable-message-reformatting"/><title>Sílabos UEB</title></head><body style="background-color:#eef2f7;margin:0;padding:0"><!--$--><!--html--><!--head--><!--body--><table border="0" width="100%" cellPadding="0" cellSpacing="0" role="presentation" align="center"><tbody><tr><td style="background-color:#eef2f7;color:#121c28;font-family:-apple-system, BlinkMacSystemFont, &#x27;Segoe UI&#x27;, Roboto, Helvetica, Arial, sans-serif, &#x27;Apple Color Emoji&#x27;, &#x27;Segoe UI Emoji&#x27;, &#x27;Segoe UI Symbol&#x27;;margin:0;padding:0;width:100%"><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="padding:25px 0;text-align:center"><tbody><tr><td><a href="http://localhost:3000" style="color:#122c41;text-decoration-line:none;font-size:19px;font-weight:bold;text-decoration:none" target="_blank">Sílabos UEB</a></td></tr></tbody></table><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="max-width:570px;background-color:#ffffff;border:1px solid #dbe3ec;border-radius:2px;margin:0 auto 32px;padding:32px"><tbody><tr style="width:100%"><td><h1 style="color:#122c41;font-size:18px;font-weight:bold;margin:0 0 16px;text-align:left">Le damos la bienvenida</h1><p style="font-size:16px;line-height:1.5em;margin:0 0 16px;text-align:left;margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0">Hola María Pérez:</p><p style="font-size:16px;line-height:1.5em;margin:0 0 16px;text-align:left;margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0">Tiene una cuenta como <strong>Docente</strong> de la carrera <strong>Ingeniería en Software (Guaranda)</strong>. Para ingresar, elija su contraseña.</p><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="margin:30px auto;text-align:center"><tbody><tr><td><a href="http://localhost:3000/activar-cuenta?token=abc%2Bdef" style="line-height:100%;text-decoration:none;display:inline-block;max-width:100%;mso-padding-alt:0px;background-color:#122c41;border-radius:4px;color:#ffffff;padding:8px 18px;padding-top:8px;padding-right:18px;padding-bottom:8px;padding-left:18px" target="_blank"><span><!--[if mso]><i style="mso-font-width:450%;mso-text-raise:12" hidden>&#8202;&#8202;</i><![endif]--></span><span style="max-width:100%;display:inline-block;line-height:120%;mso-padding-alt:0px;mso-text-raise:6px">Activar mi cuenta</span><span><!--[if mso]><i style="mso-font-width:450%" hidden>&#8202;&#8202;&#8203;</i><![endif]--></span></a></td></tr></tbody></table><p style="font-size:16px;line-height:1.5em;margin:0 0 16px;text-align:left;margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0">El enlace es personal, de un solo uso y caduca en 7 días. Si no esperaba este correo, avise a la coordinación de su carrera.</p></td></tr></tbody></table></td></tr></tbody></table><!--/$--></body></html>"`;

exports[`WorkflowNotificationMail > uses the notification title as subject and links to the system 1`] = `"<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd"><html dir="ltr" lang="es"><head><meta content="text/html; charset=UTF-8" http-equiv="Content-Type"/><meta name="x-apple-disable-message-reformatting"/><title>Sílabos UEB</title></head><body style="background-color:#eef2f7;margin:0;padding:0"><!--$--><!--html--><!--head--><!--body--><table border="0" width="100%" cellPadding="0" cellSpacing="0" role="presentation" align="center"><tbody><tr><td style="background-color:#eef2f7;color:#121c28;font-family:-apple-system, BlinkMacSystemFont, &#x27;Segoe UI&#x27;, Roboto, Helvetica, Arial, sans-serif, &#x27;Apple Color Emoji&#x27;, &#x27;Segoe UI Emoji&#x27;, &#x27;Segoe UI Symbol&#x27;;margin:0;padding:0;width:100%"><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="padding:25px 0;text-align:center"><tbody><tr><td><a href="http://localhost:3000" style="color:#122c41;text-decoration-line:none;font-size:19px;font-weight:bold;text-decoration:none" target="_blank">Sílabos UEB</a></td></tr></tbody></table><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="max-width:570px;background-color:#ffffff;border:1px solid #dbe3ec;border-radius:2px;margin:0 auto 32px;padding:32px"><tbody><tr style="width:100%"><td><p style="font-size:16px;line-height:1.5em;margin:0 0 16px;text-align:left;margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0">Hola María Pérez:</p><p style="font-size:16px;line-height:1.5em;margin:0 0 16px;text-align:left;margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0">Coordinación pidió corregir el sílabo de «Cálculo I» (Ingeniería en Software). Motivo: falta la bibliografía.</p><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="margin:30px auto;text-align:center"><tbody><tr><td><a href="http://localhost:3000/" style="line-height:100%;text-decoration:none;display:inline-block;max-width:100%;mso-padding-alt:0px;background-color:#122c41;border-radius:4px;color:#ffffff;padding:8px 18px;padding-top:8px;padding-right:18px;padding-bottom:8px;padding-left:18px" target="_blank"><span><!--[if mso]><i style="mso-font-width:450%;mso-text-raise:12" hidden>&#8202;&#8202;</i><![endif]--></span><span style="max-width:100%;display:inline-block;line-height:120%;mso-padding-alt:0px;mso-text-raise:6px">Abrir el sistema</span><span><!--[if mso]><i style="mso-font-width:450%" hidden>&#8202;&#8202;&#8203;</i><![endif]--></span></a></td></tr></tbody></table></td></tr></tbody></table></td></tr></tbody></table><!--/$--></body></html>"`;

exports[`reset password mail > sends the reset link with its expiry and the copy-the-link subcopy 1`] = `"<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd"><html dir="ltr" lang="es"><head><meta content="text/html; charset=UTF-8" http-equiv="Content-Type"/><meta name="x-apple-disable-message-reformatting"/><title>Sílabos UEB</title></head><body style="background-color:#eef2f7;margin:0;padding:0"><!--$--><!--html--><!--head--><!--body--><table border="0" width="100%" cellPadding="0" cellSpacing="0" role="presentation" align="center"><tbody><tr><td style="background-color:#eef2f7;color:#121c28;font-family:-apple-system, BlinkMacSystemFont, &#x27;Segoe UI&#x27;, Roboto, Helvetica, Arial, sans-serif, &#x27;Apple Color Emoji&#x27;, &#x27;Segoe UI Emoji&#x27;, &#x27;Segoe UI Symbol&#x27;;margin:0;padding:0;width:100%"><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="padding:25px 0;text-align:center"><tbody><tr><td><a href="http://localhost:3000" style="color:#122c41;text-decoration-line:none;font-size:19px;font-weight:bold;text-decoration:none" target="_blank">Sílabos UEB</a></td></tr></tbody></table><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="max-width:570px;background-color:#ffffff;border:1px solid #dbe3ec;border-radius:2px;margin:0 auto 32px;padding:32px"><tbody><tr style="width:100%"><td><h1 style="color:#122c41;font-size:18px;font-weight:bold;margin:0 0 16px;text-align:left">Restablezca su contraseña</h1><p style="font-size:16px;line-height:1.5em;margin:0 0 16px;text-align:left;margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0">Elija una contraseña nueva para su cuenta con el botón.</p><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="margin:30px auto;text-align:center"><tbody><tr><td><a href="http://localhost:3000/restablecer-contrasena?token=a1b2c3d4a1b2c3d4a1b2c3d4a1b2c3d4a1b2c3d4a1b2c3d4a1b2c3d4a1b2c3d4&amp;email=docente%40example.test" style="line-height:100%;text-decoration:none;display:inline-block;max-width:100%;mso-padding-alt:0px;background-color:#122c41;border-radius:4px;color:#ffffff;padding:8px 18px;padding-top:8px;padding-right:18px;padding-bottom:8px;padding-left:18px" target="_blank"><span><!--[if mso]><i style="mso-font-width:450%;mso-text-raise:12" hidden>&#8202;&#8202;</i><![endif]--></span><span style="max-width:100%;display:inline-block;line-height:120%;mso-padding-alt:0px;mso-text-raise:6px">Restablecer contraseña</span><span><!--[if mso]><i style="mso-font-width:450%" hidden>&#8202;&#8202;&#8203;</i><![endif]--></span></a></td></tr></tbody></table><p style="font-size:16px;line-height:1.5em;margin:0 0 16px;text-align:left;margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0">El enlace caduca en 60 minutos.</p><p style="font-size:16px;line-height:1.5em;margin:0 0 16px;text-align:left;margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0">Si no hizo esta solicitud, ignore este correo; su contraseña no cambiará.</p><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="border-top:1px solid #dbe3ec;margin-top:25px;padding-top:25px"><tbody><tr><td><p style="font-size:14px;line-height:1.5em;margin:0;text-align:left;margin-top:0;margin-bottom:0;margin-left:0;margin-right:0">Si el botón no funciona, copie este enlace en su navegador: <a href="http://localhost:3000/restablecer-contrasena?token=a1b2c3d4a1b2c3d4a1b2c3d4a1b2c3d4a1b2c3d4a1b2c3d4a1b2c3d4a1b2c3d4&amp;email=docente%40example.test" style="color:#122c41;text-decoration-line:none;word-break:break-all" target="_blank">http://localhost:3000/restablecer-contrasena?token=a1b2c3d4a1b2c3d4a1b2c3d4a1b2c3d4a1b2c3d4a1b2c3d4a1b2c3d4a1b2c3d4&amp;email=docente%40example.test</a></p></td></tr></tbody></table></td></tr></tbody></table></td></tr></tbody></table><!--/$--></body></html>"`;
