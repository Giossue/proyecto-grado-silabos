{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Plantilla del sílabo",
    "description": "Estructura del JSON que exporta e importa «Plantilla como JSON». La exportación escribe las claves y los valores en español; la importación acepta también los nombres en inglés de los JSON anteriores, en cualquier mezcla. El servidor valida además las reglas que este esquema no puede expresar. Manual: docs/sistema.md (JSON de la plantilla).",
    "type": "object",
    "allOf": [
        { "anyOf": [{ "required": ["secciones"] }, { "required": ["sections"] }] }
    ],
    "additionalProperties": false,
    "properties": {
        "$schema": { "type": "string" },
        "politica_respuestas": { "$ref": "#/$defs/responsePolicy" },
        "response_policy": { "$ref": "#/$defs/responsePolicy", "description": "Nombre anterior de «politica_respuestas»." },
        "documento": { "$ref": "#/$defs/document" },
        "document": { "$ref": "#/$defs/document", "description": "Nombre anterior de «documento»." },
        "variables": {
            "type": "object",
            "description": "Datos del sistema que se insertan con <span data-variable=\"clave\"></span>.",
            "propertyNames": { "pattern": "^[a-z][a-z0-9_]{0,99}$" },
            "additionalProperties": { "$ref": "#/$defs/variable" }
        },
        "tablas": { "$ref": "#/$defs/blocks" },
        "blocks": { "$ref": "#/$defs/blocks", "description": "Nombre anterior de «tablas»." },
        "secciones_obligatorias": { "$ref": "#/$defs/requiredSections" },
        "required_sections": { "$ref": "#/$defs/requiredSections", "description": "Nombre anterior de «secciones_obligatorias»." },
        "secciones_biblioteca": { "$ref": "#/$defs/librarySections" },
        "library_sections": { "$ref": "#/$defs/librarySections", "description": "Nombre anterior de «secciones_biblioteca»." },
        "campos_docente": { "$ref": "#/$defs/teacherFields" },
        "teacher_fields": { "$ref": "#/$defs/teacherFields", "description": "Nombre anterior de «campos_docente»." },
        "contenidos_predefinidos": { "type": "array", "items": { "$ref": "#/$defs/preset" } },
        "presets": { "type": "array", "items": { "$ref": "#/$defs/preset" }, "description": "Nombre anterior de «contenidos_predefinidos»." },
        "secciones": { "type": "array", "maxItems": 60, "items": { "$ref": "#/$defs/section" } },
        "sections": { "type": "array", "maxItems": 60, "items": { "$ref": "#/$defs/section" }, "description": "Nombre anterior de «secciones»." }
    },
    "$defs": {
        "responsePolicy": { "enum": ["protegida", "protected"], "description": "El formato de Administración queda protegido; los demás solo completan párrafos y celdas vacíos. «protected» es el valor anterior." },
        "blocks": {
            "type": "object",
            "description": "Piezas con datos, reglas y diseño propios. Se insertan con <div data-block=\"clave\"></div>. La exportación usa la forma corta (titulo, campos, reglas, catalogo, diseño); la importación acepta también la forma completa (label, value, rules, catalog, layout).",
            "propertyNames": { "pattern": "^[a-z][a-z0-9_]{0,40}$" },
            "additionalProperties": { "anyOf": [{ "$ref": "#/$defs/shortBlock" }, { "$ref": "#/$defs/block" }] }
        },
        "requiredSections": { "type": "array", "items": { "type": "string" }, "description": "Secciones que la plantilla no puede quitar." },
        "librarySections": { "type": "array", "items": { "type": "string" }, "description": "Secciones que revisa Biblioteca." },
        "teacherFields": { "type": "array", "items": { "$ref": "#/$defs/key" }, "description": "Campos que llena el docente en su sílabo (campus, correquisitos y su formación); no van en el perfil de la asignatura." },
        "key": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$", "maxLength": 100 },
        "html": {
            "description": "Lista de líneas HTML, un texto HTML o un documento Tiptap.",
            "anyOf": [
                { "type": "array", "items": { "type": "string" } },
                { "type": "string" },
                { "type": "object", "required": ["type"], "properties": { "type": { "const": "doc" } } }
            ]
        },
        "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "alignment": { "enum": ["izquierda", "centro", "derecha", "justificado", "left", "center", "right", "justify"] },
        "sizes": {
            "type": "object",
            "properties": {
                "titulo": { "type": "number" }, "seccion": { "type": "number" }, "texto": { "type": "number" },
                "title": { "type": "number" }, "section": { "type": "number" }, "body": { "type": "number" }
            }
        },
        "colors": {
            "type": "object",
            "properties": {
                "texto": { "$ref": "#/$defs/color" },
                "titulo": { "$ref": "#/$defs/color" },
                "fondo_encabezado_tabla": { "anyOf": [{ "$ref": "#/$defs/color" }, { "type": "null" }] },
                "texto_encabezado_tabla": { "anyOf": [{ "$ref": "#/$defs/color" }, { "type": "null" }] },
                "borde_tabla": { "$ref": "#/$defs/color" },
                "texto_vacio": { "$ref": "#/$defs/color" },
                "text": { "$ref": "#/$defs/color" },
                "title": { "$ref": "#/$defs/color" },
                "table_header_background": { "anyOf": [{ "$ref": "#/$defs/color" }, { "type": "null" }] },
                "table_header_text": { "anyOf": [{ "$ref": "#/$defs/color" }, { "type": "null" }] },
                "table_border": { "$ref": "#/$defs/color" },
                "empty_text": { "$ref": "#/$defs/color" }
            }
        },
        "titleStyle": {
            "type": "object",
            "properties": {
                "texto": { "type": "string" }, "negrita": { "type": "boolean" }, "cursiva": { "type": "boolean" }, "alineacion": { "$ref": "#/$defs/alignment" },
                "text": { "type": "string" }, "bold": { "type": "boolean" }, "italic": { "type": "boolean" }, "alignment": { "$ref": "#/$defs/alignment" }
            }
        },
        "sectionTitleStyle": {
            "type": "object",
            "properties": {
                "negrita": { "type": "boolean" }, "cursiva": { "type": "boolean" }, "alineacion": { "$ref": "#/$defs/alignment" },
                "bold": { "type": "boolean" }, "italic": { "type": "boolean" }, "alignment": { "$ref": "#/$defs/alignment" }
            }
        },
        "bodyStyle": { "type": "object", "properties": { "alineacion": { "$ref": "#/$defs/alignment" }, "alignment": { "$ref": "#/$defs/alignment" } } },
        "header": {
            "type": "object",
            "properties": {
                "logos": {
                    "type": "array",
                    "maxItems": 2,
                    "items": {
                        "type": "object",
                        "properties": {
                            "fuente": { "enum": ["institucion", "facultad", "institution", "faculty"] },
                            "alto_pt": { "type": "number" },
                            "source": { "enum": ["institucion", "facultad", "institution", "faculty"] },
                            "height_pt": { "type": "number" }
                        }
                    }
                },
                "proporcion_izquierda": { "type": "number" },
                "left_share": { "type": "number" }
            }
        },
        "choices": {
            "type": "object",
            "properties": {
                "margen_cm": { "type": "array", "items": { "type": "number" } }, "titulo": { "type": "array", "items": { "type": "number" } },
                "seccion": { "type": "array", "items": { "type": "number" } }, "texto": { "type": "array", "items": { "type": "number" } },
                "margin_cm": { "type": "array", "items": { "type": "number" } }, "title": { "type": "array", "items": { "type": "number" } },
                "section": { "type": "array", "items": { "type": "number" } }, "body": { "type": "array", "items": { "type": "number" } }
            }
        },
        "document": {
            "type": "object",
            "description": "Estilo del documento: papel, márgenes, letra, colores, encabezado y pie. Cada clave tiene su nombre anterior en inglés, que la importación también acepta.",
            "additionalProperties": false,
            "properties": {
                "papel": { "enum": ["carta", "a4", "oficio", "letter", "legal"] },
                "orientacion": { "enum": ["vertical", "horizontal", "portrait", "landscape"] },
                "margen_cm": { "type": "number" },
                "letra": { "type": "string" },
                "interlineado": { "type": "number" },
                "espacio_parrafos_pt": { "type": "number" },
                "tamaños": { "$ref": "#/$defs/sizes" },
                "colores": { "$ref": "#/$defs/colors" },
                "titulo": { "$ref": "#/$defs/titleStyle" },
                "titulo_seccion": { "$ref": "#/$defs/sectionTitleStyle" },
                "texto": { "$ref": "#/$defs/bodyStyle" },
                "encabezado": { "$ref": "#/$defs/header" },
                "pie": { "anyOf": [{ "type": "object" }, { "type": "null" }] },
                "metadatos": { "anyOf": [{ "type": "object" }, { "type": "null" }] },
                "texto_vacio": { "type": "string" },
                "opciones": { "$ref": "#/$defs/choices" },
                "paper": { "enum": ["carta", "a4", "oficio", "letter", "legal"] },
                "orientation": { "enum": ["vertical", "horizontal", "portrait", "landscape"] },
                "margin_cm": { "type": "number" },
                "font_family": { "type": "string" },
                "line_height": { "type": "number" },
                "paragraph_spacing_pt": { "type": "number" },
                "sizes": { "$ref": "#/$defs/sizes" },
                "colors": { "$ref": "#/$defs/colors" },
                "title": { "$ref": "#/$defs/titleStyle" },
                "section_title": { "$ref": "#/$defs/sectionTitleStyle" },
                "body": { "$ref": "#/$defs/bodyStyle" },
                "header": { "$ref": "#/$defs/header" },
                "footer": { "anyOf": [{ "type": "object" }, { "type": "null" }] },
                "metadata": { "anyOf": [{ "type": "object" }, { "type": "null" }] },
                "empty_text": { "type": "string" },
                "choices": { "$ref": "#/$defs/choices" }
            }
        },
        "variable": {
            "type": "object",
            "allOf": [
                { "anyOf": [{ "required": ["etiqueta"] }, { "required": ["label"] }] },
                { "anyOf": [{ "required": ["fuente"] }, { "required": ["source"] }] }
            ],
            "additionalProperties": false,
            "properties": {
                "etiqueta": { "type": "string", "maxLength": 120 },
                "fuente": { "$ref": "#/$defs/variableSource" },
                "ejemplo": { "type": "string" },
                "formato": { "enum": ["numero", "number"] },
                "igual_a": { "type": "string", "description": "Muestra X cuando el dato es igual a este texto." },
                "label": { "type": "string", "maxLength": 120 },
                "source": { "$ref": "#/$defs/variableSource" },
                "sample": { "type": "string" },
                "format": { "enum": ["numero", "number"] },
                "equals": { "type": "string", "description": "Muestra X cuando el dato es igual a este texto." }
            }
        },
        "variableSource": {
            "type": "string",
            "description": "Dato del sistema: identificacion.*, aprobacion.* o firma.* (por ejemplo identificacion.facultad, identificacion.horas_acd, aprobacion.coordinador, firma.docente). También se aceptan los nombres anteriores identification.*, approval.* y signature.*."
        },
        "condition": {
            "type": "object",
            "description": "Una fuente (value, prop, item o variable) y una prueba (equals, empty o zero). Para negar, use false en la prueba.",
            "minProperties": 2,
            "maxProperties": 2,
            "additionalProperties": false,
            "properties": {
                "value": { "type": "string" },
                "prop": { "type": "string" },
                "item": { "type": "string" },
                "variable": { "type": "string" },
                "equals": { "type": ["string", "number", "null"] },
                "empty": { "type": "boolean" },
                "zero": { "type": "boolean" }
            }
        },
        "title": { "type": "string", "maxLength": 300, "description": "Nombre del dato en la pantalla y en los errores." },
        "errorMessage": { "type": "string", "maxLength": 300, "description": "Mensaje propio al rechazar el dato." },
        "text": {
            "type": "object",
            "required": ["type"],
            "additionalProperties": false,
            "properties": {
                "type": { "const": "string" },
                "title": { "$ref": "#/$defs/title" },
                "errorMessage": { "$ref": "#/$defs/errorMessage" },
                "keep_if": { "$ref": "#/$defs/condition" },
                "maxLength": { "type": "integer", "minimum": 1, "maximum": 20000 },
                "minLength": { "enum": [0, 1], "description": "1: obligatorio." },
                "multiline": { "type": "boolean", "description": "Extensión propia: la pantalla muestra un cuadro de varias líneas." }
            }
        },
        "choice": {
            "type": "object",
            "required": ["type", "oneOf"],
            "additionalProperties": false,
            "properties": {
                "type": { "const": "string" },
                "title": { "$ref": "#/$defs/title" },
                "errorMessage": { "$ref": "#/$defs/errorMessage" },
                "keep_if": { "$ref": "#/$defs/condition" },
                "oneOf": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "object",
                        "required": ["const", "title"],
                        "additionalProperties": false,
                        "properties": { "const": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,40}$" }, "title": { "type": "string", "maxLength": 120 } }
                    }
                }
            }
        },
        "number": {
            "type": "object",
            "required": ["type"],
            "additionalProperties": false,
            "description": "Se guarda como texto con número («2», «1,5»).",
            "properties": {
                "type": { "const": "number" },
                "title": { "$ref": "#/$defs/title" },
                "errorMessage": { "$ref": "#/$defs/errorMessage" },
                "keep_if": { "$ref": "#/$defs/condition" },
                "maximum": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1000000000 },
                "multipleOf": { "enum": [1, 0.1, 0.01, 0.001, 0.0001, 0.00001, 0.000001] }
            }
        },
        "object": {
            "type": "object",
            "required": ["type", "properties"],
            "additionalProperties": false,
            "properties": {
                "type": { "const": "object" },
                "title": { "$ref": "#/$defs/title" },
                "errorMessage": { "$ref": "#/$defs/errorMessage" },
                "keep_if": { "$ref": "#/$defs/condition" },
                "properties": { "$ref": "#/$defs/values" }
            }
        },
        "array": {
            "type": "object",
            "required": ["type", "items"],
            "additionalProperties": false,
            "properties": {
                "type": { "const": "array" },
                "title": { "$ref": "#/$defs/title" },
                "errorMessage": { "$ref": "#/$defs/errorMessage" },
                "keep_if": { "$ref": "#/$defs/condition" },
                "minItems": { "type": "integer", "minimum": 0, "maximum": 100 },
                "maxItems": { "type": "integer", "minimum": 1, "maximum": 100 },
                "initial": { "type": "integer", "minimum": 0, "maximum": 100, "description": "Extensión propia: cuántos elementos tiene al empezar." },
                "items": { "$ref": "#/$defs/value" }
            }
        },
        "value": {
            "anyOf": [
                { "$ref": "#/$defs/text" },
                { "$ref": "#/$defs/choice" },
                { "$ref": "#/$defs/number" },
                { "$ref": "#/$defs/object" },
                { "$ref": "#/$defs/array" }
            ]
        },
        "values": {
            "type": "object",
            "propertyNames": { "pattern": "^[a-z][a-z0-9_]{0,40}$" },
            "additionalProperties": { "$ref": "#/$defs/value" }
        },
        "target": {
            "anyOf": [
                { "type": "number" },
                { "type": "object", "required": ["variable"], "additionalProperties": false, "properties": { "variable": { "type": "string" } } },
                { "type": "object", "required": ["count"], "additionalProperties": false, "properties": { "count": { "type": "string", "description": "Cantidad de elementos de una lista del valor." } } }
            ]
        },
        "check": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "label": { "type": "string", "maxLength": 60 },
                "count": { "type": "string" },
                "filled": { "type": "string" },
                "sum": { "type": "string" },
                "equals": { "$ref": "#/$defs/target" },
                "max": { "$ref": "#/$defs/target" },
                "min": { "$ref": "#/$defs/target" }
            }
        },
        "rule": {
            "type": "object",
            "required": ["code", "on", "message", "checks"],
            "additionalProperties": false,
            "properties": {
                "code": { "type": "string" },
                "on": { "enum": ["save", "submit"], "description": "save: rechaza el guardado. submit: impide enviar el sílabo." },
                "message": { "type": "string" },
                "hint": { "type": "string" },
                "checks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/check" } }
            }
        },
        "block": {
            "type": "object",
            "required": ["label"],
            "additionalProperties": false,
            "properties": {
                "label": { "type": "string", "maxLength": 120 },
                "props": {
                    "type": "object",
                    "description": "Textos que fija la plantilla en cada aparición del bloque.",
                    "propertyNames": { "pattern": "^[a-z][a-z0-9_]{0,40}$" },
                    "additionalProperties": { "$ref": "#/$defs/text" }
                },
                "value": { "$ref": "#/$defs/values" },
                "rules": { "type": "array", "items": { "$ref": "#/$defs/rule" } },
                "layout": { "$ref": "#/$defs/html" },
                "catalog": {
                    "type": "object",
                    "description": "Llena las filas de una lista del bloque con libros del catálogo de la biblioteca: «list» es la lista y «map» dice qué dato del libro va a cada columna de texto.",
                    "required": ["list", "map"],
                    "additionalProperties": false,
                    "properties": {
                        "list": { "$ref": "#/$defs/key" },
                        "map": {
                            "type": "object",
                            "minProperties": 1,
                            "propertyNames": { "enum": ["author", "title", "year", "place", "publisher", "isbn", "call_number", "format"] },
                            "additionalProperties": { "$ref": "#/$defs/key" }
                        }
                    }
                }
            }
        },
        "shortType": {
            "enum": ["texto", "texto largo", "número", "horas", "sí/no"],
            "description": "texto: hasta 1000 caracteres en una línea. texto largo: igual, en varias líneas. horas: hasta 999.99 con 2 decimales (la exportación lo usa para las columnas de horas). número: igual que horas; se usa cuando cambia «max» o «decimales». sí/no: opciones «si» (Sí) y «no» (No)."
        },
        "shortLeaf": {
            "type": "object",
            "additionalProperties": false,
            "description": "Un dato. Sin «tipo» es «texto». Solo se escribe lo que cambia del valor por defecto.",
            "properties": {
                "tipo": { "$ref": "#/$defs/shortType" },
                "titulo": { "$ref": "#/$defs/title" },
                "error": { "$ref": "#/$defs/errorMessage" },
                "solo_si": { "$ref": "#/$defs/condition" },
                "max": { "type": "number", "description": "Texto: máximo de caracteres (1000 por defecto). Número: valor máximo (999.99 por defecto)." },
                "min": { "enum": [0, 1], "description": "Solo texto. 1: obligatorio." },
                "decimales": { "type": "integer", "minimum": 0, "maximum": 6, "description": "Solo número u horas. 2 por defecto." }
            }
        },
        "shortChoice": {
            "type": "object",
            "required": ["opciones"],
            "additionalProperties": false,
            "properties": {
                "titulo": { "$ref": "#/$defs/title" },
                "error": { "$ref": "#/$defs/errorMessage" },
                "solo_si": { "$ref": "#/$defs/condition" },
                "opciones": {
                    "type": "object",
                    "minProperties": 1,
                    "description": "Clave de la opción y su texto: {\"presencial\": \"Presencial\"}.",
                    "propertyNames": { "pattern": "^[a-z][a-z0-9_]{0,40}$" },
                    "additionalProperties": { "type": "string", "maxLength": 120 }
                }
            }
        },
        "shortList": {
            "type": "object",
            "required": ["columnas"],
            "additionalProperties": false,
            "properties": {
                "titulo": { "$ref": "#/$defs/title", "description": "Nombre de cada fila (por ejemplo «unidad»)." },
                "filas": { "type": "string", "pattern": "^\\s*\\d{1,3}\\s*-\\s*\\d{1,3}\\s*$", "description": "Mínimo y máximo de filas, por ejemplo «1-8». Sin «filas»: 0-100." },
                "al_empezar": { "type": "integer", "minimum": 0, "maximum": 100, "description": "Filas al empezar. Por defecto, el mínimo." },
                "error": { "$ref": "#/$defs/errorMessage" },
                "solo_si": { "$ref": "#/$defs/condition" },
                "columnas": { "$ref": "#/$defs/shortFields" }
            }
        },
        "shortGroup": {
            "type": "object",
            "required": ["campos"],
            "additionalProperties": false,
            "properties": {
                "titulo": { "$ref": "#/$defs/title" },
                "error": { "$ref": "#/$defs/errorMessage" },
                "solo_si": { "$ref": "#/$defs/condition" },
                "campos": { "$ref": "#/$defs/shortFields" }
            }
        },
        "shortField": {
            "anyOf": [
                { "$ref": "#/$defs/shortType" },
                { "$ref": "#/$defs/shortLeaf" },
                { "$ref": "#/$defs/shortChoice" },
                { "$ref": "#/$defs/shortList" },
                { "$ref": "#/$defs/shortGroup" },
                { "$ref": "#/$defs/value" }
            ]
        },
        "shortFields": {
            "type": "object",
            "propertyNames": { "pattern": "^[a-z][a-z0-9_]{0,40}$" },
            "additionalProperties": { "$ref": "#/$defs/shortField" }
        },
        "shortBlock": {
            "type": "object",
            "required": ["titulo"],
            "additionalProperties": false,
            "description": "Forma corta de un bloque. Lo que no se puede escribir corto va en la forma completa: un dato con «type» o una regla como objeto.",
            "properties": {
                "titulo": { "type": "string", "maxLength": 120 },
                "propiedades": {
                    "type": "object",
                    "description": "Textos que fija la plantilla en cada aparición del bloque.",
                    "propertyNames": { "pattern": "^[a-z][a-z0-9_]{0,40}$" },
                    "additionalProperties": { "anyOf": [{ "enum": ["texto", "texto largo"] }, { "$ref": "#/$defs/shortLeaf" }, { "$ref": "#/$defs/text" }] }
                },
                "campos": { "$ref": "#/$defs/shortFields" },
                "reglas": {
                    "type": "array",
                    "description": "Nombre de una regla conocida o la regla completa.",
                    "items": {
                        "anyOf": [
                            { "enum": ["semanas_maximas", "unidades_sin_nombre", "unidades_sin_semanas", "semanas_unidades_incompletas", "horas_unidades_no_coinciden", "libros_sin_titulo"] },
                            { "$ref": "#/$defs/rule" }
                        ]
                    }
                },
                "catalogo": {
                    "type": "object",
                    "description": "Llena las filas de una lista con libros del catálogo de la biblioteca: «lista» es la lista y «columnas» dice qué dato del libro va a cada columna de texto.",
                    "required": ["lista", "columnas"],
                    "additionalProperties": false,
                    "properties": {
                        "lista": { "$ref": "#/$defs/key" },
                        "columnas": {
                            "type": "object",
                            "minProperties": 1,
                            "description": "Clave: dato del libro (autor, titulo, anio, ciudad, editorial, isbn, codigo o signatura; también se aceptan los nombres de Koha author, title, year, place, publisher, call_number y format). Valor: columna de texto de la lista.",
                            "propertyNames": { "enum": ["autor", "titulo", "anio", "ciudad", "editorial", "isbn", "codigo", "signatura", "call_number", "author", "title", "year", "place", "publisher", "format"] },
                            "additionalProperties": { "$ref": "#/$defs/key" }
                        }
                    }
                },
                "diseño": { "$ref": "#/$defs/html" }
            }
        },
        "preset": {
            "type": "object",
            "allOf": [
                { "anyOf": [{ "required": ["clave"] }, { "required": ["key"] }] },
                { "anyOf": [{ "required": ["etiqueta"] }, { "required": ["label"] }] },
                { "anyOf": [{ "required": ["campo"] }, { "required": ["field"] }] }
            ],
            "properties": {
                "clave": { "$ref": "#/$defs/key" },
                "etiqueta": { "type": "string", "maxLength": 120 },
                "campo": { "$ref": "#/$defs/key" },
                "key": { "$ref": "#/$defs/key" },
                "label": { "type": "string", "maxLength": 120 },
                "field": { "$ref": "#/$defs/key" }
            }
        },
        "showIf": {
            "type": ["object", "null"],
            "description": "Mostrar el campo solo si una respuesta anterior de elegir una o varias tiene alguna de estas opciones.",
            "allOf": [
                { "anyOf": [{ "required": ["respuesta"] }, { "required": ["response"] }] },
                { "anyOf": [{ "required": ["opciones"] }, { "required": ["options"] }] }
            ],
            "additionalProperties": false,
            "properties": {
                "respuesta": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,40}$" },
                "opciones": { "type": "array", "minItems": 1, "maxItems": 50, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,40}$" } },
                "response": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,40}$" },
                "options": { "type": "array", "minItems": 1, "maxItems": 50, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,40}$" } }
            }
        },
        "maxCharacters": {
            "type": ["integer", "null"],
            "minimum": 1,
            "maximum": 50000,
            "description": "Límite de caracteres que el docente puede escribir en el campo: su texto libre y sus respuestas de texto. Solo en campos «carrera»."
        },
        "field": {
            "type": "object",
            "allOf": [
                { "anyOf": [{ "required": ["clave"] }, { "required": ["key"] }] },
                { "required": ["quien_llena"] },
                { "anyOf": [{ "required": ["contenido"] }, { "required": ["content"] }] }
            ],
            "additionalProperties": false,
            "properties": {
                "clave": { "$ref": "#/$defs/key" },
                "etiqueta": { "type": ["string", "null"], "maxLength": 180 },
                "quien_llena": { "enum": ["carrera", "institucional"] },
                "contenido": { "$ref": "#/$defs/html" },
                "mostrar_si": { "$ref": "#/$defs/showIf" },
                "max_caracteres": { "$ref": "#/$defs/maxCharacters" },
                "key": { "$ref": "#/$defs/key" },
                "label": { "type": ["string", "null"], "maxLength": 180 },
                "content": { "$ref": "#/$defs/html" },
                "show_if": { "$ref": "#/$defs/showIf" },
                "max_length": { "$ref": "#/$defs/maxCharacters" }
            }
        },
        "section": {
            "type": "object",
            "allOf": [
                { "anyOf": [{ "required": ["clave"] }, { "required": ["key"] }] },
                { "anyOf": [{ "required": ["titulo"] }, { "required": ["title"] }] }
            ],
            "additionalProperties": false,
            "properties": {
                "clave": { "$ref": "#/$defs/key" },
                "titulo": { "type": "string", "maxLength": 180 },
                "orientacion": { "enum": ["vertical", "horizontal", "portrait", "landscape"] },
                "campos": { "type": "array", "maxItems": 60, "items": { "$ref": "#/$defs/field" } },
                "key": { "$ref": "#/$defs/key" },
                "title": { "type": "string", "maxLength": 180 },
                "orientation": { "enum": ["vertical", "horizontal", "portrait", "landscape"] },
                "fields": { "type": "array", "maxItems": 60, "items": { "$ref": "#/$defs/field" } }
            }
        }
    }
}
