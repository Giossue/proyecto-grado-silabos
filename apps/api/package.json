{
  "name": "@silabos/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch --preserveWatchOutput",
    "build": "prisma generate && nest build",
    "start": "node dist/apps/api/src/main.js",
    "worker": "node dist/apps/api/src/worker.js",
    "storage:migrate": "tsx scripts/storage-migrate.ts",
    "queue:smoke": "tsx --env-file-if-exists=../../.env.local src/server/queue/smoke.ts",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prisma": "prisma",
    "db:pull": "prisma db pull",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:baseline": "prisma migrate resolve --applied 0_baseline",
    "db:seed": "tsx --env-file-if-exists=../../.env.local src/db/seed.ts",
    "db:migrate-auth": "tsx --env-file-if-exists=../../.env.local src/db/migrateAuth.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1177.0",
    "@nestjs/common": "12.6.2",
    "@nestjs/config": "12.1.1",
    "@nestjs/core": "12.6.2",
    "@nestjs/platform-express": "12.6.2",
    "@nestjs/swagger": "12.1.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.3.1",
    "@xmldom/xmldom": "^0.9.12",
    "@zxing/library": "^0.23.0",
    "asn1js": "^4.1.0",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.7.28",
    "bullmq": "^6.7.8",
    "cookie-parser": "1.4.7",
    "drizzle-orm": "^0.45.4",
    "entities": "^9.0.0",
    "exceljs": "^4.4.0",
    "express": "5.3.0",
    "ioredis": "^6.1.0",
    "jszip": "^3.10.2",
    "nestjs-zod": "5.6.0",
    "node-forge": "^1.4.4",
    "nodemailer": "^10.6.1",
    "openid-client": "^6.9.1",
    "otpauth": "^9.6.0",
    "pg": "^8.23.1",
    "pkijs": "^4.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.15",
    "@nestjs/testing": "12.6.2",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "^24.19.2",
    "@types/node-forge": "^1.3.14",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/supertest": "7.2.1",
    "eslint": "^9",
    "prisma": "7.10.1",
    "supertest": "7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "typescript-eslint": "^8.74.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.1.1"
  }
}
