    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "eslint": "^9",
    "typescript": "^5",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.1"
  }
}
