{
  "name": "@silabos/shared",
  "version": "0.1.0",
  "private": true,
  "exports": {
    "./test/fixtures/*": {
      "import": "./src/test/fixtures/*"
    },
    "./*": {
      "types": "./src/*.ts",
      "import": "./src/*.ts"
    }
