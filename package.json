{
  "name": "silabos-ueb",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @silabos/web --filter @silabos/api run dev",
    "build": "pnpm --filter @silabos/api run build && pnpm --filter @silabos/web run build",
    "start": "pnpm --parallel --filter @silabos/web --filter @silabos/api run start",
    "worker": "pnpm --filter @silabos/api run worker",
    "queue:smoke": "pnpm --filter @silabos/api run queue:smoke",
    "lint": "pnpm -r run lint",
    "test": "pnpm -r run test",
    "test:cambios": "pnpm -r exec vitest run --changed --silent=passed-only",
    "typecheck": "pnpm -r run typecheck",
    "test:e2e": "pnpm --filter @silabos/web run test:e2e",
    "db:pull": "pnpm --filter @silabos/api run db:pull",
    "db:generate": "pnpm --filter @silabos/api run db:generate",
    "db:migrate": "pnpm --filter @silabos/api run db:migrate",
    "db:status": "pnpm --filter @silabos/api run db:status",
    "db:baseline": "pnpm --filter @silabos/api run db:baseline",
    "db:seed": "pnpm --filter @silabos/api run db:seed"
  }
}
